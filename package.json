{
    "name": "hn_keynav_extension",
    "version": "1.0.0",
    "description": "Keyboard navigation, highlighting, and friend notes for Hacker News comments.",
    "scripts": {
        "build": "npm run typecheck && esbuild src/main.ts --bundle --platform=browser --format=iife --target=es2022 --sourcemap --minify --outfile=build/main.bundle.js",
        "watch": "esbuild src/main.ts --bundle --platform=browser --format=iife --target=es2022 --sourcemap --outfile=build/main.bundle.js --watch",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint . --error-on-warnings",
        "format": "biome format --write .",
        "test": "npm run build && node --test tests/*.test.cjs",
        "check": "biome check . --error-on-warnings && npm test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nickscript0/hn_comments_nav.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/nickscript0/hn_comments_nav/issues"
    },
    "homepage": "https://github.com/nickscript0/hn_comments_nav#readme",
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "esbuild": "^0.28.2",
        "jsdom": "^31.0.0",
        "typescript": "^7.0.2"
    },
    "private": true,
    "engines": {
        "node": "26.x"
    }
}
