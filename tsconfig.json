{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "types": []
    },
    "include": ["src/**/*.ts"]
}
